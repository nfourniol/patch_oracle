#!/bin/bash

source ~/.bash_profile
# Absolute path: the script changes directory (cd into the patch) before removing
# the lock file and sending the email, so a relative BASEDIR (e.g. '.') would break them
readonly BASEDIR=$(cd "$(dirname "$0")" && pwd)
readonly INITIAL_DIRECTORY=$(pwd)
readonly PID=$$ # ID du process exécutant refreshAutoCore
readonly TYPE_ERROR="ERROR"

# We load sources for Teams notification
source $BASEDIR/lib/teamsNotification
# We load sources for the lock file <PID>.patch_oracle
source $BASEDIR/lib/processLock

function execute_sql_on_cdb() {
	# Execute SQL on Container Database
	local sql="$1"
	echo "$sql"
	echo "$sql" | sqlplus / as sysdba
}

function restart_database_and_listener() {
	# we ensure database is started because we shut it previously.
	execute_sql_on_cdb "startup;"

	echo "Start the oracle listener"
	lsnrctl start

	lnrctl_status=$(lsnrctl status | grep "The listener supports no services")
	echo "Wait for listener to be correctly started and list of services"
	count=0
	while [ ! -z "$lnrctl_status" ] && [ "$count" -lt "300" ]
	do
		((count++))
		sleep 1
		echo -n "."
		lnrctl_status=$(lsnrctl status | grep "The listener supports no services")
	done
	echo ""
}

echo "Tests the existence of patch_oracle.conf"
if [ ! -f $BASEDIR/patch_oracle.conf ] || [ ! -r $BASEDIR/patch_oracle.conf ]; then
	# No notification possible: the email / Teams settings are in patch_oracle.conf
	echo "ERROR: Impossible to read $BASEDIR/patch_oracle.conf"
	exit 1
fi

# patch_oracle.conf is read first, so that every error detected afterwards
# (disk space, environment, ...) can be notified by email / Teams
echo "Read of $BASEDIR/patch_oracle.conf"
declare -A properties
configuration_file="$BASEDIR/patch_oracle.conf"
while IFS='=' read -r key value; do
    # Read of patch_oracle.conf (properties file), we remove comments of type # ... using the sed command
    # The surrounding quotes are removed too (e.g. teams.workflow.tecinfra="https://...")
    value=$(echo $value | sed 's/[[:space:]]//g' | sed 's/\#.*//g' | sed "s/^[\"']//;s/[\"']\$//")
    if [ ! -z "$key" ]; then # If a line is empty, then key is empty
        properties["$key"]="$value"
    fi
done < "$configuration_file"

echo "Extract values from $BASEDIR/patch_oracle.conf"
oracle_opatch_fullpath=${properties["oracle.opatch.fullpath"]}
oracle_patch_fullpath=${properties["oracle.patch.fullpath"]}
oracle_patch_directory=${properties["oracle.patch.directory"]}
smtp_host=${properties["mail.smtp_host"]}
mail_to=${properties["mail.mail_to"]}
mail_from=${properties["mail.mail_from"]}
teams_workflow=${properties["teams.workflow.tecinfra"]}

endPatch() {
    # This funtion should be the last treatment executed

	type=$1
	msg=$2
	echo "$msg"

	object="[patch_oracle] Patch successfully applied on host $HOSTNAME"
	if [ "$type" == "$TYPE_ERROR" ]; then
		object="[patch_oracle] ERROR while applying the patch on host $HOSTNAME"
	fi

	if [ ! -z "$smtp_host" ]; then
		echo "An email is sent to inform you that '$object'"
		bash ${BASEDIR}/lib/sendMail.sh $smtp_host $mail_from "'$mail_to'" "$object" "$msg"
	fi
	if [ ! -z "$teams_workflow" ]; then
		echo "Sends a Teams notification to inform you that '$object'"
		if [ "$type" == "$TYPE_ERROR" ]; then
			send_red_notification "$teams_workflow" "$object" "$msg"
		else
			send_green_notification "$teams_workflow" "$object" "$msg"
		fi
	fi

	if [ "$type" == "$TYPE_ERROR" ]; then
		exit 1
    else
		exit 0
    fi
}

echo "Disk space verification"
# Configuration: Minimum size in GB required
REQUIRED_SPACE_GB=15
REQUIRED_SPACE_BYTES=$((REQUIRED_SPACE_GB * 1024 * 1024 * 1024))

# Checks that the ORACLE_BASE and ORACLE_HOME variables are defined
if [[ -z "$ORACLE_BASE" && -z "$ORACLE_HOME" ]]; then
    endPatch "$TYPE_ERROR" "ERROR: ORACLE_BASE and ORACLE_HOME are not defined. Cannot proceed."
fi

# Use ORACLE_BASE as priority, otherwise fallback to ORACLE_HOME
ORACLE_DIR=${ORACLE_BASE:-$ORACLE_HOME}

# Find the mount point associated with ORACLE_DIR
MOUNT_POINT=$(df --output=target "$ORACLE_DIR" | tail -1)

if [[ -z "$MOUNT_POINT" ]]; then
    endPatch "$TYPE_ERROR" "ERROR: Unable to determine the mount point for $ORACLE_DIR."
fi

echo "Oracle directory: $ORACLE_DIR"
echo "Detected mount point: $MOUNT_POINT"

# Recovers free space for the mount point
AVAILABLE_BYTES=$(df --output=avail --block-size=1 "$MOUNT_POINT" | tail -1)

if [[ -z "$AVAILABLE_BYTES" || "$AVAILABLE_BYTES" -eq 0 ]]; then
    endPatch "$TYPE_ERROR" "ERROR: Unable to determine available space on $MOUNT_POINT."
fi

echo "Available space on $MOUNT_POINT: $((AVAILABLE_BYTES / 1024 / 1024 / 1024)) GB"

# Check that there is enough space available
if [[ $AVAILABLE_BYTES -lt $REQUIRED_SPACE_BYTES ]]; then
    endPatch "$TYPE_ERROR" "ERROR: Insufficient disk space on $MOUNT_POINT: $((AVAILABLE_BYTES / 1024 / 1024 / 1024)) GB available, at least ${REQUIRED_SPACE_GB}GB is required."
fi


echo "Disk space is sufficient to apply the patch"
echo "Check that the script is being executed as an oracle user"
if [ "$(whoami)" != "oracle" ]; then
	endPatch "$TYPE_ERROR" "ERROR: you should execute this script as an oracle user (current user: $(whoami))"
fi

echo "Tests the existence of ORACLE_BASE"
if [ -z "$ORACLE_BASE" ] || [ ! -d "$ORACLE_BASE" ]; then
	endPatch "$TYPE_ERROR" "ERROR: the environment variable ORACLE_BASE is incorrect: empty or targets on a non existing directory. ORACLE_BASE=$ORACLE_BASE"
fi

echo "Tests the existence of ORACLE_HOME"
if [ -z "$ORACLE_HOME" ] || [ ! -d "$ORACLE_HOME" ]; then
	endPatch "$TYPE_ERROR" "ERROR: the environment variable ORACLE_HOME is incorrect: empty or targets on a non existing directory. ORACLE_HOME=$ORACLE_HOME"
fi

startPatch() {
    # This funtion is used to create $PID.patch_oracle file (removed automatically at exit, see lib/processLock)
    if acquire_process_lock "$BASEDIR" "patch_oracle" "$PID" "patch_oracle_core"; then
        echo "Patch process started. Process ID = $PID. Lock file: $PROCESS_LOCK_FILE"
    else
        echo "ERROR$PROCESS_LOCK_CONFLICT found"
        endPatch $TYPE_ERROR "ERROR$PROCESS_LOCK_CONFLICT found: there is another patch_oracle that is currently executed"
    fi
}

startPatch

echo "Tests the existence of oracle.opatch.fullpath and oracle.patch.fullpath"
if [ -z "$oracle_opatch_fullpath" ] || [ -z "$oracle_patch_fullpath" ]; then
	endPatch "$TYPE_ERROR" "ERROR: the patch script configuration variables oracle_opatch_fullpath and oracle_patch_fullpath are empty: oracle_opatch_fullpath=$oracle_opatch_fullpath and oracle_patch_fullpath=$oracle_patch_fullpath"
fi

echo "Tests the existence of oracle.opatch.fullpath"
if [ ! -f "$oracle_opatch_fullpath" ] || [ ! -r "$oracle_opatch_fullpath" ]; then
	endPatch "$TYPE_ERROR" "ERROR: the OPatch file $oracle_opatch_fullpath does not exist or does not have read permissions"
fi

echo "Tests the existence of oracle.patch.fullpath"
if [ ! -f "$oracle_patch_fullpath" ] || [ ! -r "$oracle_patch_fullpath" ]; then
	endPatch "$TYPE_ERROR" "ERROR: the patch file $oracle_patch_fullpath does not exist or does not have read permissions"
fi

echo "Tests that oracle.patch.directory is a root directory of the patch zip"
if [ -z "$oracle_patch_directory" ]; then
	endPatch "$TYPE_ERROR" "ERROR: oracle.patch.directory is empty in patch_oracle.conf"
fi
# unzip -Z1 lists the entries of the zip (one path per line)
if ! unzip -Z1 "$oracle_patch_fullpath" | grep -q "^$oracle_patch_directory/"; then
	endPatch "$TYPE_ERROR" "ERROR: The $oracle_patch_directory folder was not found in the patch zip $oracle_patch_fullpath. Check oracle.patch.directory in patch_oracle.conf (root directories of the zip: $(unzip -Z1 "$oracle_patch_fullpath" | cut -d '/' -f 1 | sort -u | tr '\n' ' '))"
fi

# Environment variables that should be set
export PATH=$ORACLE_HOME/bin:$PATH:$ORACLE_HOME/OPatch
export LD_LIBRARY_PATH=$ORACLE_HOME/lib:/lib:/usr/lib
export CLASSPATH=$ORACLE_HOME/jlib:$ORACLE_HOME/rdbms/jlib

# version.txt contains a line such as "OPATCH_VERSION:12.2.0.1.44": we keep the part after ':' without spaces
current_opatch_version=$(cut -d ':' -f 2 "$ORACLE_HOME/OPatch/version.txt" 2>/dev/null | tr -d '[:space:]')
echo "current_opatch_version=$current_opatch_version"
new_opatch_version=$(unzip -p "$oracle_opatch_fullpath" OPatch/version.txt | cut -d ':' -f 2 | tr -d '[:space:]')
echo "new_opatch_version=$new_opatch_version"

if [ -z "$new_opatch_version" ]; then
	endPatch "$TYPE_ERROR" "ERROR: OPatch/version.txt not found in $oracle_opatch_fullpath: is it an OPatch zip (p6880880_...)? The database has not been stopped."
fi

# sort -V compares version numbers field by field (12.2.0.1.44 < 12.2.1.0.1 < 12.2.1.0.10)
most_recent_opatch_version=$(printf '%s\n%s\n' "$current_opatch_version" "$new_opatch_version" | sort -V | tail -1)

if [ "$new_opatch_version" == "$current_opatch_version" ]; then
	echo "No OPatch update, the current version is up to date"
elif [ "$most_recent_opatch_version" != "$new_opatch_version" ]; then
	echo "No OPatch update, the current version $current_opatch_version is more recent than $new_opatch_version"
else
	opatch_backup_directory=""
	if [ -e "$ORACLE_HOME/OPatch" ]; then
		echo "Updating OPatch from $current_opatch_version to $new_opatch_version"
		opatch_backup_directory="$ORACLE_HOME/OPatch.old.v${current_opatch_version:-unknown}"
		if [ -e "$opatch_backup_directory" ]; then
			# Never move OPatch INTO an existing backup directory
			opatch_backup_directory="${opatch_backup_directory}_$(date +%Y%m%d%H%M%S)"
		fi
		echo "mv $ORACLE_HOME/OPatch $opatch_backup_directory"
		if ! mv "$ORACLE_HOME/OPatch" "$opatch_backup_directory"; then
			endPatch "$TYPE_ERROR" "ERROR: unable to move $ORACLE_HOME/OPatch to $opatch_backup_directory. The database has not been stopped."
		fi
	else
		echo "No OPatch in $ORACLE_HOME: installation of OPatch $new_opatch_version"
	fi
	echo "unzip of the new OPatch :"
	if ! unzip -q "$oracle_opatch_fullpath" -d "$ORACLE_HOME/"; then
		rm -rf "$ORACLE_HOME/OPatch"
		if [ -n "$opatch_backup_directory" ]; then
			echo "unzip failed: restore of the previous OPatch"
			mv "$opatch_backup_directory" "$ORACLE_HOME/OPatch"
			endPatch "$TYPE_ERROR" "ERROR: unzip of $oracle_opatch_fullpath into $ORACLE_HOME failed, the previous OPatch ($current_opatch_version) has been restored. The database has not been stopped."
		fi
		endPatch "$TYPE_ERROR" "ERROR: unzip of $oracle_opatch_fullpath into $ORACLE_HOME failed, there is no OPatch in $ORACLE_HOME. The database has not been stopped."
	fi
	echo "OPatch version now installed: $(cut -d ':' -f 2 "$ORACLE_HOME/OPatch/version.txt" | tr -d '[:space:]')"
fi

if [ ! -d $ORACLE_BASE/patch ]; then
    echo "Create patch folder in $ORACLE_BASE/ ==> $ORACLE_BASE/patch"
	mkdir $ORACLE_BASE/patch
fi

# The patch is unzipped and the directory from which 'opatch apply' must be run is
# determined BEFORE stopping the database: if something is wrong here, we stop
# without any downtime.
echo "unzip -o $oracle_patch_fullpath -d $ORACLE_BASE/patch/"
# unzip with the -o option to overwrite PatchSearch.xml, which is at the root of the patch zips
# This avoids the question: replace /u01/app/oracle/patch/PatchSearch.xml? [y]es, [n]o, [A]ll, [N]one, [r]ename: y
unzip -o $oracle_patch_fullpath -d $ORACLE_BASE/patch/
if [ "$?" -ne 0 ]; then
	endPatch "$TYPE_ERROR" "ERROR: unzip of $oracle_patch_fullpath into $ORACLE_BASE/patch/ failed. The database has not been stopped."
fi

patch_root_directory="$ORACLE_BASE/patch/$oracle_patch_directory"
if [ ! -f "$patch_root_directory/README.html" ]; then
	endPatch "$TYPE_ERROR" "ERROR: $patch_root_directory/README.html not found. Check oracle.patch.directory in patch_oracle.conf. The database has not been stopped."
fi

# README.html contains the 'opatch apply' instructions, preceded by a line such as:
#   cd <UNZIPPED_PATCH_LOCATION>/36233126/36199232
# The first number is the root directory of the zip, the second (if any) is the
# subdirectory from which 'opatch apply' must be run.
# We only keep the first matching line and extract complete numbers ([0-9]+: the
# former [1-9]* regex split numbers containing a 0, e.g. 37260974 => 3726 974).
unzipped_location_line=$(grep -B 2 'opatch apply' "$patch_root_directory/README.html" | grep UNZIPPED_PATCH_LOCATION | head -1)
echo "Line of README.html giving the patch location: $unzipped_location_line"
patch_subdirectory=$(echo "$unzipped_location_line" | grep -o -E '[0-9]+' | sed -n '2p')

opatch_apply_directory="$patch_root_directory"
if [ -n "$patch_subdirectory" ]; then
	opatch_apply_directory="$patch_root_directory/$patch_subdirectory"
fi

if ! cd "$opatch_apply_directory"; then
	endPatch "$TYPE_ERROR" "ERROR: the directory $opatch_apply_directory (deduced from $patch_root_directory/README.html) does not exist. The database has not been stopped."
fi
echo "Current directory = $(pwd)"

echo "Oracle listener stop"
lsnrctl stop
# we ensure database is stopped
execute_sql_on_cdb "shutdown immediate;"

echo "opatch apply OPatch.SKIP_VERIFY=true -jdk $ORACLE_HOME/jdk"

##
yes | opatch apply OPatch.SKIP_VERIFY=true -jdk $ORACLE_HOME/jdk
opatch_apply_result_code=$?
##

echo "opatch apply returned the result code: $opatch_apply_result_code"

# The database and the listener were stopped before 'opatch apply': whatever the
# result of opatch, we restart them so that the server is not left down.
restart_database_and_listener

if [ "$opatch_apply_result_code" -ne 0 ]; then
	endPatch "$TYPE_ERROR" "ERROR: opatch apply failed with result code $opatch_apply_result_code on host $HOSTNAME. The database and the listener have been restarted. The unzipped patch has been kept in $ORACLE_BASE/patch/$oracle_patch_directory for analysis. Check the log file and the OPatch logs in $ORACLE_HOME/cfgtoollogs/opatch"
fi

echo "Patch was applied with success. Now we clean disk from the unzip patch: rm -rf $ORACLE_BASE/patch/$oracle_patch_directory"
# We leave the patch directory (cd done for 'opatch apply') before removing it: otherwise the
# current directory no longer exists and the commands launched afterwards fail on getcwd
cd "$BASEDIR"
rm -rf $ORACLE_BASE/patch/$oracle_patch_directory

if [ -n "$opatch_backup_directory" ] && [ -d "$opatch_backup_directory" ]; then
	echo "!!! you can remove $opatch_backup_directory to free space if you want !!!"
fi
echo "==============================================="
echo "Success: End of application of the oracle patch"
echo "==============================================="

endPatch "Success" "Success: End of application of the oracle patch"
